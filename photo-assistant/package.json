{
  "name": "smori-photo-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "S. MORI installation photo assistant: upload photos, compress, generate bilingual case copy with Claude, save as a draft installation_case metaobject in Shopify.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --import tsx src/server.ts",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx test/*.test.ts",
    "shopify": "shopify",
    "deploy:shopify": "shopify app deploy",
    "env:pull": "shopify app env pull"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "dotenv": "^18.0.0",
    "exif-reader": "^2.0.3",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@shopify/cli": "^4.8.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.1",
    "typescript": "^7.0.2"
  }
}
