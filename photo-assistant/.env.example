# ---- Shopify app (from the Dev Dashboard, or `shopify app env pull`) ----
SHOPIFY_API_KEY=            # Client ID
SHOPIFY_API_SECRET=         # Client secret — never commit
SHOPIFY_APP_URL=https://smori-photo-assistant.fly.dev   # must match shopify.app.toml
SHOPIFY_SHOP=smori-9216.myshopify.com                   # the store this app serves
SHOPIFY_API_VERSION=2026-07
SHOPIFY_STORE_HANDLE=smori-9216                         # for admin links
# SCOPES is optional; defaults to the list in shopify.app.toml

# ---- Secrets for this server ----
SESSION_SECRET=             # >= 32 random chars: `openssl rand -hex 32`. Encrypts stored tokens + signs cookies.
ADMIN_PASSWORD=             # staff UI password (user "smori"); required in production

# ---- Anthropic ----
ANTHROPIC_API_KEY=          # never commit
CLAUDE_MODEL=claude-opus-5

# ---- App ----
PORT=3000
DATA_DIR=./data
METAOBJECT_TYPE=installation_case

# Legacy fallback only (not used with OAuth): a static Admin API token
# SHOPIFY_ADMIN_TOKEN=
