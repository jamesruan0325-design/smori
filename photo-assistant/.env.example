# ---- Shopify app (from the Dev Dashboard, or `shopify app env pull`) ----
SHOPIFY_API_KEY=            # Client ID
SHOPIFY_API_SECRET=         # Client secret — never commit
SHOPIFY_APP_URL=https://smori-photo-assistant.fly.dev   # must match shopify.app.toml
SHOPIFY_SHOP=smori-9216.myshopify.com                   # the store this app serves
SHOPIFY_API_VERSION=2026-07
SHOPIFY_STORE_HANDLE=smori-9216                         # for admin links
# SCOPES is optional; defaults to the list in shopify.app.toml

# ---- Secrets for this server ----
SESSION_SECRET=             # >= 32 random chars: `openssl rand -hex 32`. Encrypts stored tokens + signs cookies.
ADMIN_PASSWORD=             # staff UI password (user "smori"); required in production

# ---- Anthropic ----
ANTHROPIC_API_KEY=          # never commit
CLAUDE_MODEL=claude-opus-5

# ---- App ----
PORT=3000
DATA_DIR=./data
METAOBJECT_TYPE=installation_case

# Legacy fallback only (not used with OAuth): a static Admin API token
# SHOPIFY_ADMIN_TOKEN=

# ---- Automatic pipeline (Dropbox camera uploads -> screening -> case -> publish) ----
DROPBOX_APP_KEY=            # from dropbox.com/developers/apps (secret)
DROPBOX_APP_SECRET=         # (secret) — never commit
DROPBOX_FOLDER=/Camera Uploads
AUTO_ENABLED=true
AUTO_POLL_MINUTES=10
AUTO_PUBLISH=false          # false: only create drafts; true: auto-publish confident cases
AUTO_PUBLISH_CONFIDENCE=0.8 # used only when AUTO_PUBLISH=true
PROJECT_CLOSE_HOURS=6       # hours without new photos before a job is finalised
CLUSTER_GAP_HOURS=8
CLUSTER_RADIUS_METERS=400
TIMEZONE=America/Los_Angeles
CLAUDE_SCREEN_MODEL=claude-sonnet-5
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=                 # (secret-ish) a long random topic name; subscribe to it in the ntfy phone app
INBOX_TOKEN=                # (secret) bearer token for POST /api/inbox (phone shortcuts); optional

# ---- Website AI assistant ----
CLAUDE_CHAT_MODEL=claude-opus-5
CLAUDE_CHAT_EFFORT=medium
CHAT_RATE_PER_HOUR=40       # messages per client IP per hour
CHAT_MAX_TURNS=40
# PROXY_SIGNATURE_OPTIONAL=true   # local testing only; never in production
