<nav class="navbar" id="navbar">
  <div class="nav-container">
    <a href="/" class="nav-logo">{{ section.settings.logo_text }}</a>

    <div class="nav-links" id="navLinks">
      {% for i in (1..3) %}
        {% assign text_key = 'link' | append: i | append: '_text' %}
        {% assign url_key = 'link' | append: i | append: '_url' %}
        {% if section.settings[text_key] != blank %}
          <a href="{{ section.settings[url_key] }}" class="nav-link">{{ section.settings[text_key] }}</a>
        {% endif %}
      {% endfor %}
      <a href="{{ section.settings.cta_url | default: '#contact' }}" class="nav-link nav-cta">{{ section.settings.cta_text | default: 'Book Consultation' }}</a>
    </div>

    <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation">
      <span class="nav-toggle-line"></span>
      <span class="nav-toggle-line"></span>
      <span class="nav-toggle-line"></span>
    </button>
  </div>
</nav>

{% schema %}
{
  "name": "Navbar",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "SMORI"
    },
    { "type": "header", "content": "Links" },
    { "type": "text", "id": "link1_text", "label": "Link 1 text", "default": "Collections" },
    { "type": "text", "id": "link1_url", "label": "Link 1 URL", "default": "/#collections" },
    { "type": "text", "id": "link2_text", "label": "Link 2 text", "default": "Installations" },
    { "type": "text", "id": "link2_url", "label": "Link 2 URL", "default": "/pages/installations" },
    { "type": "text", "id": "link3_text", "label": "Link 3 text" },
    { "type": "text", "id": "link3_url", "label": "Link 3 URL" },
    { "type": "text", "id": "cta_text", "label": "Button text", "default": "Book Consultation" },
    { "type": "text", "id": "cta_url", "label": "Button URL", "default": "#contact" }
  ],
  "presets": [
    {
      "name": "Navbar"
    }
  ]
}
{% endschema %}
