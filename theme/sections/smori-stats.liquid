<section class="stats-bar">
  <div class="container">
    <div class="stats-grid">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <div class="stat-item" {{ block.shopify_attributes }}>
            <span class="stat-number">
              <span class="stat-value" data-target="{{ block.settings.number }}">{{ block.settings.number }}</span>{{ block.settings.suffix }}
            </span>
            <span class="stat-label">{{ block.settings.label }}</span>
          </div>
        {% endfor %}
      {% else %}
        <div class="stat-item">
          <span class="stat-number"><span class="stat-value" data-target="10">10</span>+</span>
          <span class="stat-label">Years of Excellence</span>
        </div>
        <div class="stat-item">
          <span class="stat-number"><span class="stat-value" data-target="12000">12000</span>+</span>
          <span class="stat-label">Homes Transformed</span>
        </div>
        <div class="stat-item">
          <span class="stat-number"><span class="stat-value" data-target="1200">1200</span>+</span>
          <span class="stat-label">Premium Fabrics</span>
        </div>
        <div class="stat-item">
          <span class="stat-number"><span class="stat-value" data-target="98">98</span>%</span>
          <span class="stat-label">Client Satisfaction</span>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Stats Bar",
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "10"
        },
        {
          "type": "text",
          "id": "suffix",
          "label": "Suffix",
          "default": "+",
          "info": "e.g. +, %, K"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Years"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Stats Bar",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "number": "10",
            "suffix": "+",
            "label": "Years of Excellence"
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": "12000",
            "suffix": "+",
            "label": "Homes Transformed"
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": "1200",
            "suffix": "+",
            "label": "Premium Fabrics"
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": "98",
            "suffix": "%",
            "label": "Client Satisfaction"
          }
        }
      ]
    }
  ]
}
{% endschema %}
