<section class="hero" id="home">
  <div class="hero-bg">
    {% if section.settings.background_image != blank %}
      <div class="hero-bg-image" style="background-image: url('{{ section.settings.background_image | image_url: width: 1920 }}');">
        <div class="hero-overlay"></div>
      </div>
    {% else %}
      <div class="curtain curtain-left"></div>
      <div class="curtain curtain-right"></div>
      <div class="curtain-glow"></div>
    {% endif %}
  </div>

  <div class="hero-content">
    <span class="hero-tagline">{{ section.settings.tagline }}</span>
    <h1 class="hero-heading">
      {{ section.settings.heading }}
      {% if section.settings.heading_accent != blank %}
        <em>{{ section.settings.heading_accent }}</em>
      {% endif %}
    </h1>
    <p class="hero-description">{{ section.settings.description }}</p>
    <div class="hero-buttons">
      {% if section.settings.button1_text != blank %}
        <a href="{{ section.settings.button1_url }}" class="btn btn-primary">{{ section.settings.button1_text }}</a>
      {% endif %}
      {% if section.settings.button2_text != blank %}
        <a href="{{ section.settings.button2_url }}" class="btn btn-secondary">{{ section.settings.button2_text }}</a>
      {% endif %}
    </div>
  </div>

  <div class="hero-scroll">
    <span>Scroll to Explore</span>
    <div class="scroll-line"></div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Luxury Window Fashions"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Transform Your Space with"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading Accent (italic)",
      "default": "Timeless Elegance"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Curated window treatments from the world's finest manufacturers, tailored to your unique vision. Experience the art of light, privacy, and design."
    },
    {
      "type": "text",
      "id": "button1_text",
      "label": "Button 1 Text",
      "default": "Explore Collections"
    },
    {
      "type": "text",
      "id": "button1_url",
      "label": "Button 1 URL",
      "default": "#collections"
    },
    {
      "type": "text",
      "id": "button2_text",
      "label": "Button 2 Text",
      "default": "Book Consultation"
    },
    {
      "type": "text",
      "id": "button2_url",
      "label": "Button 2 URL",
      "default": "#contact"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image",
      "info": "Leave empty to show the default curtain gradient effect."
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
