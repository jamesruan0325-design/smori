<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="footer-logo">{{ section.settings.brand_name }}</a>
        <p class="footer-description">{{ section.settings.brand_description }}</p>
        <div class="footer-social">
          {% if section.settings.instagram_url != blank %}
            <a href="{{ section.settings.instagram_url }}" class="social-link" aria-label="Instagram" target="_blank" rel="noopener">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
            </a>
          {% endif %}
          {% if section.settings.pinterest_url != blank %}
            <a href="{{ section.settings.pinterest_url }}" class="social-link" aria-label="Pinterest" target="_blank" rel="noopener">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M8 12a4 4 0 1 1 8 0c0 3-2 5-4 5s-2-1-2-1"></path>
                <path d="M9 17l1-4"></path>
                <circle cx="12" cy="12" r="10"></circle>
              </svg>
            </a>
          {% endif %}
          {% if section.settings.facebook_url != blank %}
            <a href="{{ section.settings.facebook_url }}" class="social-link" aria-label="Facebook" target="_blank" rel="noopener">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
              </svg>
            </a>
          {% endif %}
        </div>
      </div>

      <!-- Column 1 -->
      <div class="footer-column">
        <h4 class="footer-column-title">{{ section.settings.col1_title }}</h4>
        <ul class="footer-links">
          {% if section.settings.col1_link1_text != blank %}
            <li><a href="{{ section.settings.col1_link1_url }}">{{ section.settings.col1_link1_text }}</a></li>
          {% endif %}
          {% if section.settings.col1_link2_text != blank %}
            <li><a href="{{ section.settings.col1_link2_url }}">{{ section.settings.col1_link2_text }}</a></li>
          {% endif %}
          {% if section.settings.col1_link3_text != blank %}
            <li><a href="{{ section.settings.col1_link3_url }}">{{ section.settings.col1_link3_text }}</a></li>
          {% endif %}
          {% if section.settings.col1_link4_text != blank %}
            <li><a href="{{ section.settings.col1_link4_url }}">{{ section.settings.col1_link4_text }}</a></li>
          {% endif %}
          {% if section.settings.col1_link5_text != blank %}
            <li><a href="{{ section.settings.col1_link5_url }}">{{ section.settings.col1_link5_text }}</a></li>
          {% endif %}
        </ul>
      </div>

      <!-- Column 2 -->
      <div class="footer-column">
        <h4 class="footer-column-title">{{ section.settings.col2_title }}</h4>
        <ul class="footer-links">
          {% if section.settings.col2_link1_text != blank %}
            <li><a href="{{ section.settings.col2_link1_url }}">{{ section.settings.col2_link1_text }}</a></li>
          {% endif %}
          {% if section.settings.col2_link2_text != blank %}
            <li><a href="{{ section.settings.col2_link2_url }}">{{ section.settings.col2_link2_text }}</a></li>
          {% endif %}
          {% if section.settings.col2_link3_text != blank %}
            <li><a href="{{ section.settings.col2_link3_url }}">{{ section.settings.col2_link3_text }}</a></li>
          {% endif %}
          {% if section.settings.col2_link4_text != blank %}
            <li><a href="{{ section.settings.col2_link4_url }}">{{ section.settings.col2_link4_text }}</a></li>
          {% endif %}
          {% if section.settings.col2_link5_text != blank %}
            <li><a href="{{ section.settings.col2_link5_url }}">{{ section.settings.col2_link5_text }}</a></li>
          {% endif %}
        </ul>
      </div>

      <!-- Column 3 -->
      <div class="footer-column">
        <h4 class="footer-column-title">{{ section.settings.col3_title }}</h4>
        <ul class="footer-links">
          {% if section.settings.col3_link1_text != blank %}
            <li><a href="{{ section.settings.col3_link1_url }}">{{ section.settings.col3_link1_text }}</a></li>
          {% endif %}
          {% if section.settings.col3_link2_text != blank %}
            <li><a href="{{ section.settings.col3_link2_url }}">{{ section.settings.col3_link2_text }}</a></li>
          {% endif %}
          {% if section.settings.col3_link3_text != blank %}
            <li><a href="{{ section.settings.col3_link3_url }}">{{ section.settings.col3_link3_text }}</a></li>
          {% endif %}
          {% if section.settings.col3_link4_text != blank %}
            <li><a href="{{ section.settings.col3_link4_url }}">{{ section.settings.col3_link4_text }}</a></li>
          {% endif %}
          {% if section.settings.col3_link5_text != blank %}
            <li><a href="{{ section.settings.col3_link5_url }}">{{ section.settings.col3_link5_text }}</a></li>
          {% endif %}
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-copyright">{{ section.settings.copyright_text }}</p>
    </div>
  </div>
</footer>

