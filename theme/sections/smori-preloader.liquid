<div class="preloader" id="preloader">
    <div class="preloader-inner">
        <span class="preloader-logo">{{ section.settings.logo_text }}</span>
        <div class="preloader-bar"><div class="preloader-fill"></div></div>
    </div>
</div>

{% schema %}
{
  "name": "Preloader",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "SMORI"
    }
  ]
}
{% endschema %}
