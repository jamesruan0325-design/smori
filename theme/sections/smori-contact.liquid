<section class="contact" id="contact">
  <div class="container">
    <div class="contact-layout">
      <div class="contact-left">
        <span class="section-label">{{ section.settings.section_label }}</span>
        <h2>{{ section.settings.heading }}</h2>
        <p class="contact-lead">{{ section.settings.description }}</p>

        <div class="contact-details">
          <div class="contact-row">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <div>
              <small>Phone</small>
              <span><a href="tel:{{ section.settings.phone | remove: '(' | remove: ')' | remove: ' ' | remove: '-' }}">{{ section.settings.phone }}</a></span>
            </div>
          </div>

          <div class="contact-row">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            <div>
              <small>Email</small>
              <span><a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></span>
            </div>
          </div>

          <div class="contact-row">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <div>
              <small>Showroom</small>
              <span>{{ section.settings.address }}</span>
            </div>
          </div>

          <div class="contact-row">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <div>
              <small>Hours</small>
              <span>{{ section.settings.hours }}</span>
            </div>
          </div>
        </div>
      </div>

      <div class="booking-form">
        <h3>{{ section.settings.form_heading }}</h3>
        {% form 'contact' %}
          {% if form.posted_successfully? %}
            <div class="form-success">
              <p>Thank you for your inquiry. We'll be in touch within 24 hours.</p>
            </div>
          {% endif %}

          {% if form.errors %}
            <div class="form-errors">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

          <div class="form-field">
            <input type="text" name="contact[name]" placeholder="Your Name" required>
          </div>
          <div class="form-grid">
            <div class="form-field">
              <input type="email" name="contact[email]" placeholder="Email Address" required>
            </div>
            <div class="form-field">
              <input type="tel" name="contact[phone]" placeholder="Phone Number">
            </div>
          </div>
          <div class="form-field">
            <select name="contact[service]">
              <option value="" disabled selected>Service Interested In</option>
              <option value="consultation">In-Home Consultation</option>
              <option value="motorization">Motorization & Smart Home</option>
              <option value="commercial">Commercial Project</option>
              <option value="replacement">Replacement & Repair</option>
              <option value="other">Other</option>
            </select>
          </div>
          <div class="form-field">
            <textarea name="contact[body]" placeholder="Tell us about your project..." rows="4"></textarea>
          </div>
          <button type="submit" class="btn btn-primary">Schedule Consultation</button>
        {% endform %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact",
  "settings": [
    {
      "type": "text",
      "id": "section_label",
      "label": "Section Label",
      "default": "Get in Touch"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Begin Your Transformation"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Schedule a complimentary in-home consultation with our design experts. We'll bring the showroom to you."
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone Number",
      "default": "(949) 880-1322"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email Address",
      "default": "BonnieX@smoriwindowfashion.com"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Address",
      "default": "23 Mauchly Suite 106, Irvine, CA 92618"
    },
    {
      "type": "text",
      "id": "hours",
      "label": "Business Hours",
      "default": "Mon-Fri: 9AM-5PM | Weekends: By Appointment Only"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Form Heading",
      "default": "Request a Consultation"
    }
  ],
  "presets": [
    {
      "name": "Contact"
    }
  ]
}
{% endschema %}
