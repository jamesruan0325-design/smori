<section class="testimonials" id="testimonials">
  <div class="container">
    <div class="section-header">
      <span class="section-label">{{ section.settings.section_label }}</span>
      <h2 class="section-title">{{ section.settings.heading }}</h2>
    </div>

    <div class="testimonials-grid">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <div class="testimonial-card" {{ block.shopify_attributes }}>
            <div class="testimonial-quote">
              <svg class="quote-icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                <path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"></path>
                <path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"></path>
              </svg>
              <p>{{ block.settings.quote }}</p>
            </div>
            <div class="testimonial-author">
              <div class="author-avatar">{{ block.settings.author_initial }}</div>
              <div class="author-info">
                <span class="author-name">{{ block.settings.author_name }}</span>
                <span class="author-location">{{ block.settings.author_location }}</span>
              </div>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <div class="testimonial-card">
          <div class="testimonial-quote">
            <svg class="quote-icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
              <path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"></path>
              <path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"></path>
            </svg>
            <p>SMORI transformed our living room completely. The Silhouette shadings they recommended filter light beautifully while maintaining our ocean view. The installation team was impeccable.</p>
          </div>
          <div class="testimonial-author">
            <div class="author-avatar">S</div>
            <div class="author-info">
              <span class="author-name">Sarah Chen</span>
              <span class="author-location">Newport Beach, CA</span>
            </div>
          </div>
        </div>
        <div class="testimonial-card">
          <div class="testimonial-quote">
            <svg class="quote-icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
              <path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"></path>
              <path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"></path>
            </svg>
            <p>From the initial consultation to the final installation, every detail was handled with exceptional care. Our Duette honeycomb shades reduced our energy bill noticeably.</p>
          </div>
          <div class="testimonial-author">
            <div class="author-avatar">M</div>
            <div class="author-info">
              <span class="author-name">Michael Torres</span>
              <span class="author-location">Irvine, CA</span>
            </div>
          </div>
        </div>
        <div class="testimonial-card">
          <div class="testimonial-quote">
            <svg class="quote-icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
              <path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"></path>
              <path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"></path>
            </svg>
            <p>The PowerView motorization system SMORI installed is incredible. We control all our window treatments with our phones, and the automated sunrise schedule is life-changing.</p>
          </div>
          <div class="testimonial-author">
            <div class="author-avatar">E</div>
            <div class="author-info">
              <span class="author-name">Emily Watson</span>
              <span class="author-location">Laguna Beach, CA</span>
            </div>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "section_label",
      "label": "Section Label",
      "default": "Client Stories"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Our Clients Say"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Client testimonial goes here."
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Author Name",
          "default": "Client Name"
        },
        {
          "type": "text",
          "id": "author_location",
          "label": "Author Location",
          "default": "City, State"
        },
        {
          "type": "text",
          "id": "author_initial",
          "label": "Author Initial",
          "default": "C",
          "info": "Displayed in the avatar circle."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "quote": "SMORI transformed our living room completely. The Silhouette shadings they recommended filter light beautifully while maintaining our ocean view. The installation team was impeccable.",
            "author_name": "Sarah Chen",
            "author_location": "Newport Beach, CA",
            "author_initial": "S"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "From the initial consultation to the final installation, every detail was handled with exceptional care. Our Duette honeycomb shades reduced our energy bill noticeably.",
            "author_name": "Michael Torres",
            "author_location": "Irvine, CA",
            "author_initial": "M"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "The PowerView motorization system SMORI installed is incredible. We control all our window treatments with our phones, and the automated sunrise schedule is life-changing.",
            "author_name": "Emily Watson",
            "author_location": "Laguna Beach, CA",
            "author_initial": "E"
          }
        }
      ]
    }
  ]
}
{% endschema %}
