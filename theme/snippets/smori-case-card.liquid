{%- comment -%}
  Installation case card. Used by sections/smori-cases.liquid for both
  metaobject entries and manual (theme editor) blocks.

  Params:
    card_title, card_subtitle, card_summary      strings (already localised)
    card_category                                 category key (sheer, blackout …)
    card_room, card_location, card_product_name   strings
    card_image                                    image / file object (optional)
    card_image_alt                                string
    card_url                                      link target (optional)
    card_photo_count                              number (optional)
    card_attrs                                    block.shopify_attributes (optional)
{%- endcomment -%}

{%- liquid
  assign category_label = card_category
  if card_category != blank
    assign category_key = 'smori.cases.categories.' | append: card_category
    assign translated = category_key | t
    unless translated contains 'translation missing'
      assign category_label = translated
    endunless
  endif

  assign img = card_image
  if card_image.preview_image
    assign img = card_image.preview_image
  endif
-%}

<article class="case-card" data-case-category="{{ card_category | escape }}" {{ card_attrs }}>
  {%- if card_url != blank -%}
    <a class="case-media" href="{{ card_url }}" aria-label="{{ card_title | escape }}">
  {%- else -%}
    <div class="case-media">
  {%- endif -%}
    {%- if img != blank -%}
      {{ img | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(max-width: 768px) 100vw, (max-width: 1100px) 50vw, 420px', alt: card_image_alt }}
    {%- else -%}
      <div class="case-media-placeholder"></div>
    {%- endif -%}
    {%- if card_room != blank -%}
      <span class="case-room">{{ card_room }}</span>
    {%- endif -%}
    {%- if card_photo_count > 1 -%}
      <span class="case-count">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="5" width="18" height="14" rx="1"/><path d="m3 16 5-5 4 4 3-3 6 6"/></svg>
        {{ card_photo_count }}
      </span>
    {%- endif -%}
  {%- if card_url != blank -%}
    </a>
  {%- else -%}
    </div>
  {%- endif -%}

  <div class="case-body">
    {%- if category_label != blank -%}
      <span class="case-category">{{ category_label }}</span>
    {%- endif -%}
    <h3 class="case-title">
      {%- if card_url != blank -%}<a href="{{ card_url }}">{{ card_title }}</a>{%- else -%}{{ card_title }}{%- endif -%}
    </h3>
    {%- if card_product_name != blank or card_location != blank -%}
      <div class="case-meta">
        {%- if card_product_name != blank -%}<span>{{ card_product_name }}</span>{%- endif -%}
        {%- if card_location != blank -%}<span>{{ card_location }}</span>{%- endif -%}
      </div>
    {%- endif -%}
    {%- if card_summary != blank -%}
      <p class="case-summary">{{ card_summary | strip_html | truncatewords: 26 }}</p>
    {%- endif -%}
    {%- if card_url != blank -%}
      <a class="case-link" href="{{ card_url }}">{{ 'smori.cases.view_project' | t }} <span aria-hidden="true">&rarr;</span></a>
    {%- endif -%}
  </div>
</article>
